<Window x:Class="ParkWise.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ParkWise — Apoio à decisão"
        Width="1280"
        Height="820"
        MinWidth="900"
        MinHeight="620"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginPage}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <ContentControl Content="{Binding CurrentPage}" />
        </Grid>

        <Grid>
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsLoginPage}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="248" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{StaticResource SidebarBrush}">
                    <DockPanel Margin="18,22,18,18">
                        <StackPanel DockPanel.Dock="Top" Margin="4,0,0,31">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="38" Height="38" Background="#D4E68F"
                                        CornerRadius="12,12,12,4">
                                    <TextBlock Text="P" Foreground="#17392E" FontSize="20"
                                               FontWeight="Bold" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="ParkWise" Foreground="White" FontSize="20"
                                               FontWeight="Bold" />
                                    <TextBlock Text="DECISION WORKSPACE" Foreground="#AFC2B5"
                                               FontSize="9" FontWeight="SemiBold"
                                               Margin="1,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="#345548" Margin="0,23,0,0" />
                            <TextBlock Text="ESPAÇO DE TRABALHO" Foreground="#89A494"
                                       FontSize="9" FontWeight="Bold"
                                       Margin="7,22,0,10" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,0">
                            <Border Height="1" Background="#345548" Margin="0,0,0,14" />
                            <TextBlock Text="ISPGAYA  ·  2026/2027" Foreground="#AFC2B5"
                                       FontSize="10" FontWeight="SemiBold" />
                            <TextBlock Text="Sistema de Apoio à Decisão" Foreground="#81998A"
                                       FontSize="10" Margin="0,4,0,0" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding NavigationItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.NavigateCommand,
                                                      RelativeSource={RelativeSource AncestorType=Window}}"
                                            AutomationProperties.Name="{Binding Label}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource NavButtonStyle}">
                                        <TextBlock Text="{Binding Label}"
                                                   Foreground="{Binding Foreground,
                                                       RelativeSource={RelativeSource AncestorType=Button}}"
                                                   VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>

                <Grid Grid.Column="1" Background="{StaticResource BackgroundBrush}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="{StaticResource CardBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                            Padding="30,20">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentTitle}" FontSize="25"
                                           FontWeight="Bold"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CurrentSubtitle}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,4,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                    CornerRadius="11" Padding="12,8"
                                    VerticalAlignment="Center" Margin="18,0,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                             VerticalAlignment="Center" />
                                    <TextBlock Text="D4SP" Foreground="{StaticResource AccentBrush}"
                                               FontSize="10" FontWeight="Bold" Margin="7,0,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentPage}"
                                    Margin="30,26,30,30" />
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
