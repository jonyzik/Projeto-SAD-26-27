<Application x:Class="ParkWise.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ParkWise.App.ViewModels"
             xmlns:views="clr-namespace:ParkWise.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
                <views:DashboardView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScienceParkSearchViewModel}">
                <views:ScienceParkSearchView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScienceParkDetailsViewModel}">
                <views:ScienceParkDetailsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScienceParkComparisonViewModel}">
                <views:ScienceParkComparisonView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
                <views:PlaceholderView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
