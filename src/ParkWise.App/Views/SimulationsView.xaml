<UserControl x:Class="ParkWise.App.Views.SimulationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="#173C48" CornerRadius="10" Padding="16" Margin="0,0,0,20">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Atualizar" Command="{Binding LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="14,0,0,0" />
                        <Button Content="Nova simulação" Command="{Binding NewCommand}"
                                Style="{StaticResource ActionButtonStyle}" Margin="10,0,0,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="Simulações guardadas" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="Abra uma simulação para rever os resultados ou duplique-a para testar outros parâmetros."
                               Style="{StaticResource HintTextStyle}" Margin="0,0,0,16" />

                    <ItemsControl ItemsSource="{Binding Simulations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="0,12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="2*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding CreatedAt}" Style="{StaticResource HintTextStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding BestPark}" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding BestParkCost}" Foreground="{StaticResource AccentBrush}"
                                                       FontSize="12" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,12,0">
                                            <TextBlock Text="{Binding Candidates}" Style="{StaticResource HintTextStyle}" />
                                            <TextBlock Text="{Binding Consistency}" Style="{StaticResource HintTextStyle}" Margin="0,3,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Abrir" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.OpenCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource ActionButtonStyle}" Padding="12,6" />
                                            <Button Content="Duplicar" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource SecondaryButtonStyle}" Padding="12,6" Margin="8,0,0,0" />
                                            <Button Content="Eliminar" CommandParameter="{Binding}"
                                                    Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    Style="{StaticResource DangerButtonStyle}" Padding="12,6" Margin="8,0,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Ainda não existem simulações guardadas. Crie a primeira com «Nova simulação»."
                               Style="{StaticResource HintTextStyle}" FontSize="13"
                               Visibility="{Binding HasNoSimulations, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
