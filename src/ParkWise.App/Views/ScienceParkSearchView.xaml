<UserControl x:Class="ParkWise.App.Views.ScienceParkSearchView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource StatusBannerStyle}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="Pesquisar parques" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Nome" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding NameQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchInputStyle}" AutomationProperties.Name="Pesquisar por nome" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Localização" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding LocationQuery, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource SearchInputStyle}" AutomationProperties.Name="Pesquisar por localização" />
                        </StackPanel>
                    </Grid>

                    <Expander Header="Filtros adicionais" Margin="0,12,0,0">
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="Serviços" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding ServiceFilters}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                                  Style="{StaticResource ServiceCheckBoxStyle}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Preço mensal por m² (€)" Foreground="{StaticResource MutedBrush}"
                                       Margin="0,8,0,8" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="16" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Mínimo" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding MinimumPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchInputStyle}" AutomationProperties.Name="Preço mínimo" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Máximo" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,6" />
                                    <TextBox Text="{Binding MaximumPrice, UpdateSourceTrigger=PropertyChanged}"
                                             Style="{StaticResource SearchInputStyle}" AutomationProperties.Name="Preço máximo" />
                                </StackPanel>
                                <Button Grid.Column="3" Content="Limpar" Command="{Binding ClearFiltersCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right"
                                        VerticalAlignment="Bottom" Margin="12,0,0,0" />
                            </Grid>
                            <TextBlock Text="{Binding FilterMessage}" Foreground="#FFB98B"
                                       Margin="0,10,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,18">
                <StackPanel>
                    <Grid Margin="0,0,0,13">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Mapa dos parques" FontSize="17" FontWeight="Bold" />
                            <TextBlock Text="Explore a localização dos parques encontrados."
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}"
                                CornerRadius="999" Padding="10,5" VerticalAlignment="Center">
                            <TextBlock Text="OPENSTREETMAP" Foreground="{StaticResource AccentBrush}"
                                       FontSize="9" FontWeight="Bold" />
                        </Border>
                    </Grid>
                    <Border Height="370" BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                        <Grid>
                            <wv2:WebView2 x:Name="MapBrowser" Visibility="Collapsed" />
                            <Border x:Name="MapSetupPanel" Background="#F8FAF6">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="440" Margin="26">
                                    <Border Width="46" Height="46" Background="{StaticResource AccentSoftBrush}"
                                            CornerRadius="15,15,15,4" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE707;" FontFamily="Segoe MDL2 Assets"
                                                   Foreground="{StaticResource AccentBrush}" FontSize="20"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock x:Name="MapSetupTitle"
                                               Text="A preparar o mapa"
                                               FontSize="16" FontWeight="Bold" TextAlignment="Center"
                                               Margin="0,14,0,0" />
                                    <TextBlock x:Name="MapSetupMessage"
                                               Text="O mapa OpenStreetMap está a iniciar."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="MapEmptyPanel" Background="#F8FAF6" Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                            MaxWidth="440" Margin="26">
                                    <TextBlock Text="Sem coordenadas para mostrar"
                                               FontSize="16" FontWeight="Bold" TextAlignment="Center" />
                                    <TextBlock Text="Adicione latitude e longitude aos parques do catálogo. Os parques de demonstração indicam o centro aproximado da cidade."
                                               Foreground="{StaticResource MutedBrush}" FontSize="11"
                                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,7,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                    <TextBlock Text="Dados cartográficos © OpenStreetMap contributors. Os marcadores de demonstração são aproximados ao centro da cidade."
                               Foreground="{StaticResource MutedBrush}" FontSize="10"
                               TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding ResultCountText}" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SelectedCountText}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Grid.Column="1" Content="Comparar selecionados" Command="{Binding OpenComparisonCommand}"
                        Style="{StaticResource ActionButtonStyle}" Margin="12,0,0,0" VerticalAlignment="Center" />
            </Grid>

            <TextBlock Text="Nenhum parque corresponde aos filtros atuais." Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasNoResults}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Results}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding City}" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding PriceText}" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                    <CheckBox Content="Comparar" IsChecked="{Binding IsSelected}"
                                              Style="{StaticResource ServiceCheckBoxStyle}" Margin="0,14,0,12"
                                              HorizontalAlignment="Right" />
                                    <Button Content="Ver detalhes"
                                            Command="{Binding DataContext.ShowDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
