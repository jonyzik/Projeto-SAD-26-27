<UserControl x:Class="ParkWise.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:ParkWise.App.Navigation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <DockPanel Margin="0,0,0,16">
                <Button DockPanel.Dock="Right" Content="Atualizar dados"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" />
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Fill="{StaticResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0,0,9,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}"
                               FontSize="12" VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>

            <Border Background="{StaticResource SidebarBrush}" CornerRadius="18"
                    Padding="25" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="190" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                        <TextBlock Text="DECISÕES, BEM INFORMADAS"
                                   Foreground="#D4E68F" FontSize="10" FontWeight="Bold" />
                        <TextBlock Text="Encontre o parque certo para a sua próxima ideia."
                                   Foreground="White" FontSize="25" FontWeight="Bold"
                                   TextWrapping="Wrap" LineHeight="31" Margin="0,10,0,0" />
                        <TextBlock Text="Explore alternativas, compare o que importa e avance com confiança."
                                   Foreground="#C3D1C7" FontSize="12" TextWrapping="Wrap"
                                   Margin="0,8,0,16" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Explorar parques"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static nav:PageKeys.ScienceParks}"
                                    Style="{StaticResource ActionButtonStyle}" />
                            <Button Content="Definir preferências"
                                    Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{x:Static nav:PageKeys.NewSimulation}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="9,0,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#244B3C" CornerRadius="16"
                            Padding="16" VerticalAlignment="Stretch">
                        <Grid>
                            <Ellipse Width="112" Height="112" Fill="#315E48"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <Ellipse Width="78" Height="78" Fill="#D4E68F"
                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="10" Foreground="{StaticResource SidebarBrush}"
                                           FontSize="38" FontWeight="Bold" HorizontalAlignment="Center" />
                                <TextBlock Text="CRITÉRIOS" Foreground="{StaticResource SidebarBrush}"
                                           FontSize="8" FontWeight="Bold" HorizontalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="45 comparações AHP"
                                       Foreground="#E8F0E7" FontSize="10" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Grid Margin="0,0,0,19">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="Visão geral" FontSize="18" FontWeight="Bold"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="Indicadores do catálogo"
                           Foreground="{StaticResource MutedBrush}" FontSize="11"
                           HorizontalAlignment="Right" VerticalAlignment="Center" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Indicators}" Margin="0,0,0,20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12"
                                MinHeight="112">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="42" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="11" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding Value}" FontSize="24" FontWeight="Bold"
                                               Margin="0,5,0,1" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Caption}" Foreground="{StaticResource MutedBrush}"
                                               FontSize="10" TextWrapping="Wrap" />
                                </StackPanel>
                                <Border Grid.Column="1" Width="38" Height="38"
                                        Background="{StaticResource AccentSoftBrush}"
                                        CornerRadius="12,12,12,4" VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                               Foreground="{StaticResource AccentBrush}" FontSize="16"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.15*" />
                    <ColumnDefinition Width="0.85*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="Distribuição de preços" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="Renda mensal por metro quadrado"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Margin="0,4,0,18" />
                        <ItemsControl ItemsSource="{Binding PriceDistribution}">
                            <ItemsControl.Style>
                                <Style TargetType="ItemsControl">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasPriceDistribution}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ItemsControl.Style>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,13">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="76" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="10" VerticalAlignment="Center" />
                                        <ProgressBar Grid.Column="1" Height="8" Minimum="0"
                                                     Maximum="{Binding DataContext.PricedParkCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                     Value="{Binding Count}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Count}" FontSize="10"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="Ainda não há preços suficientes para mostrar a distribuição."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoPriceDistribution}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Simulações recentes" FontSize="15" FontWeight="Bold" />
                        <TextBlock Text="O seu trabalho mais recente"
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   Margin="0,4,0,13" />
                        <ItemsControl ItemsSource="{Binding RecentSimulations}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="0,0,0,1" Padding="0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="11"
                                                       TextWrapping="Wrap" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding CreatedAt}"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="As suas simulações guardadas vão aparecer aqui."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,7,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNoRecentSimulations}" Value="True">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                <StackPanel>
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{Binding ParkListTitle}" FontSize="15" FontWeight="Bold" />
                            <TextBlock Text="Alternativas adicionadas ao catálogo"
                                       Foreground="{StaticResource MutedBrush}" FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding RecentParks.Count, StringFormat={}{0} registos}"
                                   Foreground="{StaticResource AccentBrush}" FontSize="10"
                                   FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Grid>
                    <DataGrid ItemsSource="{Binding RecentParks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              RowHeaderWidth="0" MinHeight="160" MaxHeight="270">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parque" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Localização" Binding="{Binding City}" Width="2*" />
                            <DataGridTextColumn Header="Preço/m²" Binding="{Binding Price}" Width="*" />
                            <DataGridTextColumn Header="Registo" Binding="{Binding CreatedAt}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Ainda não existem parques registados."
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,12,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRecentParks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
