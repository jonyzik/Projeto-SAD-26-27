<UserControl x:Class="ParkWise.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="#173C48" CornerRadius="10" Padding="16" Margin="0,0,0,24">
                <TextBlock Text="{Binding DemoNotice}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            </Border>

            <TextBlock Text="Visão geral" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding Stats}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" MinHeight="110">
                            <StackPanel>
                                <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                <TextBlock Text="{Binding Value}" FontSize="28" FontWeight="SemiBold" Margin="0,7,0,3" />
                                <TextBlock Text="{Binding Caption}" Foreground="{StaticResource AccentBrush}" FontSize="11" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,12,0">
                <StackPanel>
                    <TextBlock Text="Parques de exemplo" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBlock Text="Entradas fictícias para pré-visualização da tabela."
                               Foreground="{StaticResource MutedBrush}" Margin="0,0,0,16" />
                    <DataGrid ItemsSource="{Binding Parks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              RowHeaderWidth="0" MinHeight="170">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parque" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Localização" Binding="{Binding City}" Width="2*" />
                            <DataGridTextColumn Header="Custo mensal" Binding="{Binding MonthlyCost}" Width="*" />
                            <DataGridTextColumn Header="Estado" Binding="{Binding Status}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
