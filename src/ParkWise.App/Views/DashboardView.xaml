<UserControl x:Class="ParkWise.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:nav="clr-namespace:ParkWise.App.Navigation">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource StatusBannerStyle}" Margin="0,0,0,20">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Atualizar" Command="{Binding RefreshCommand}"
                            Style="{StaticResource ActionButtonStyle}" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}"
                               TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <TextBlock Text="Visão geral" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,14" />
            <ItemsControl ItemsSource="{Binding Indicators}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}" Margin="0,0,12,12" MinHeight="120">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" FontSize="13" />
                                    <TextBlock Text="{Binding Value}" FontSize="27" FontWeight="SemiBold" Margin="0,7,0,3" />
                                    <TextBlock Text="{Binding Caption}" Foreground="{StaticResource AccentBrush}"
                                               FontSize="11" TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Icon}" FontFamily="Segoe MDL2 Assets"
                                           Foreground="{StaticResource AccentBrush}" FontSize="23" Margin="12,0,0,0" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource CardStyle}" Margin="0,14,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                        <Button Content="Explorar parques"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{x:Static nav:PageKeys.ScienceParks}"
                                Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,10,0" />
                        <Button Content="Configurar critérios AHP"
                                Command="{Binding DataContext.NavigateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{x:Static nav:PageKeys.NewSimulation}"
                                Style="{StaticResource ActionButtonStyle}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Comece a explorar alternativas" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Configure as preferências; a criação de simulações está em desenvolvimento."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,7,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,12,0">
                <StackPanel>
                    <TextBlock Text="{Binding ParkListTitle}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <DataGrid ItemsSource="{Binding RecentParks}" AutoGenerateColumns="False"
                              IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column"
                              RowHeaderWidth="0" MinHeight="180">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Parque" Binding="{Binding Name}" Width="2*" />
                            <DataGridTextColumn Header="Localização" Binding="{Binding City}" Width="2*" />
                            <DataGridTextColumn Header="Preço/m²" Binding="{Binding Price}" Width="*" />
                            <DataGridTextColumn Header="Registo" Binding="{Binding CreatedAt}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Ainda não existem parques registados." Foreground="{StaticResource MutedBrush}" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRecentParks}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,12,0">
                <StackPanel>
                    <TextBlock Text="Últimas simulações" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14" />
                    <ItemsControl ItemsSource="{Binding RecentSimulations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" FontSize="14" />
                                    <TextBlock Grid.Column="1" Text="{Binding CreatedAt}"
                                               Foreground="{StaticResource MutedBrush}" Margin="12,0,0,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="Ainda não existem simulações." Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoRecentSimulations}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,12,0">
                <StackPanel>
                    <TextBlock Text="Distribuição por preço de aluguer" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Intervalos mensais em euros por m², apenas para parques com preço válido."
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,16" />
                    <ItemsControl ItemsSource="{Binding PriceDistribution}">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasPriceDistribution}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="32" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Label}" Foreground="{StaticResource MutedBrush}" />
                                    <ProgressBar Grid.Column="1" Height="10" Minimum="0"
                                                 Maximum="{Binding DataContext.PricedParkCount, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                 Value="{Binding Count}" Foreground="{StaticResource AccentBrush}"
                                                 Background="{StaticResource BorderBrush}" />
                                    <TextBlock Grid.Column="2" Text="{Binding Count}" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="São necessários preços válidos de pelo menos dois parques para mostrar o gráfico."
                               Foreground="{StaticResource MutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoPriceDistribution}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
