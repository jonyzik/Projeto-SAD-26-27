
<UserControl
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel>
            <Border Style="{StaticResource CardStyle}"
                    Padding="24"
                    Margin="0,0,0,18">

                <StackPanel>
                    <TextBlock Text="Nova simulação"
                               FontSize="23"
                               FontWeight="SemiBold"
                               Margin="0,0,0,12"/>

                    <TextBlock Text="Configuração da simulação de seleção de parques tecnológicos."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,0,0,18"/>

                    <TextBlock Text="Os dez critérios de avaliação serão utilizados na análise AHP."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>

</UserControl>
