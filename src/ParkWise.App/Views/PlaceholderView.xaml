<UserControl x:Class="ParkWise.App.Views.PlaceholderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch" VerticalAlignment="Top">
            <StackPanel Margin="8">
                <Border Background="#173C48" CornerRadius="6" Padding="10,5"
                        HorizontalAlignment="Left" Margin="0,0,0,20">
                    <TextBlock Text="EM DESENVOLVIMENTO" Foreground="{StaticResource AccentBrush}"
                               FontSize="11" FontWeight="SemiBold" />
                </Border>
                <TextBlock Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,10" />
                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                           Foreground="{StaticResource MutedBrush}" FontSize="14" Margin="0,0,0,24" />
                <TextBlock Text="Previsto para este módulo" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding PlannedCapabilities}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="•" Foreground="{StaticResource AccentBrush}" Margin="0,0,10,0" />
                                <TextBlock Text="{Binding}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </ScrollViewer>
</UserControl>
