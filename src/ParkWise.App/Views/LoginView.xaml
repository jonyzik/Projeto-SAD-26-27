
<UserControl x:Class="ParkWise.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F7FC">

    <UserControl.Resources>

        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E9F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#171F43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="PasswordStyle" TargetType="PasswordBox">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E9F2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#171F43"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="LoginButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="Background" Value="#6657E8"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

    </UserControl.Resources>

    <Grid Background="#F5F7FC">

        <Border Width="430"
                Padding="40"
                Background="White"
                CornerRadius="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <Border.Effect>
                <DropShadowEffect Color="#171F43"
                                  BlurRadius="25"
                                  ShadowDepth="4"
                                  Opacity="0.10"/>
            </Border.Effect>

            <StackPanel>

                <!-- Logótipo -->
                <Border Width="58"
                        Height="58"
                        Background="#6657E8"
                        CornerRadius="14"
                        HorizontalAlignment="Center"
                        Margin="0,0,0,22">

                    <TextBlock Text="P"
                               Foreground="White"
                               FontSize="34"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <TextBlock Text="ParkWise"
                           FontSize="27"
                           FontWeight="Bold"
                           Foreground="#171F43"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="SELEÇÃO DE PARQUES"
                           FontSize="10"
                           Foreground="#68738E"
                           HorizontalAlignment="Center"
                           Margin="0,5,0,28"/>

                <TextBlock Text="Bem-vindo de volta"
                           FontSize="23"
                           FontWeight="SemiBold"
                           Foreground="#171F43"
                           HorizontalAlignment="Center"/>

                <TextBlock Text="Inicia sessão para aceder à plataforma."
                           FontSize="13"
                           Foreground="#68738E"
                           HorizontalAlignment="Center"
                           Margin="0,8,0,28"/>

                <!-- Email -->
                <TextBlock Text="Email"
                           FontWeight="SemiBold"
                           Foreground="#171F43"
                           Margin="0,0,0,6"/>

                <TextBox x:Name="EmailTextBox"
                    Style="{StaticResource InputStyle}"
                    Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"/>

                <!-- Palavra-passe -->
                <TextBlock Text="Palavra-passe"
                           FontWeight="SemiBold"
                           Foreground="#171F43"
                           Margin="0,18,0,6"/>

                <PasswordBox x:Name="PasswordInput"
                    Style="{StaticResource PasswordStyle}"
                    PasswordChanged="PasswordInput_PasswordChanged"/>

                <!-- Mensagem de erro -->
                <TextBlock x:Name="ErrorMessage"
                    Text="{Binding ErrorMessage}"
                    Foreground="#D64545"
                    FontSize="12"
                    TextWrapping="Wrap"
                    Margin="0,12,0,0"/>

                <!-- Botão -->
                <Button Content="Entrar"
                    Command="{Binding LoginCommand}"
                    Style="{StaticResource LoginButtonStyle}"
                    Margin="0,25,0,0"/>

                <TextBlock Text="ParkWise · Sistemas de Apoio à Decisão"
                           Foreground="#9AA3B5"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           Margin="0,28,0,0"/>

            </StackPanel>
        </Border>
    </Grid>

</UserControl>
