<UserControl x:Class="ParkWise.App.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource BackgroundBrush}">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.08*" />
            <ColumnDefinition Width="0.92*" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="{StaticResource SidebarBrush}" ClipToBounds="True">
            <Ellipse Width="540" Height="540" Fill="#244B3C"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-170,-230" />
            <Ellipse Width="330" Height="330" Stroke="#3B654F" StrokeThickness="1"
                     HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-62,-120" />
            <Grid Margin="56,48">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="43" Height="43" Background="#D4E68F"
                            CornerRadius="13,13,13,4">
                        <TextBlock Text="P" Foreground="#17392E" FontSize="23"
                                   FontWeight="Bold" HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="ParkWise" Foreground="White" FontSize="23"
                               FontWeight="Bold" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>

                <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,20,0,24">
                    <TextBlock Text="ESCOLHAS COM MAIS CONTEXTO"
                               Foreground="#D4E68F" FontSize="10" FontWeight="Bold" />
                    <TextBlock Text="O espaço certo muda tudo."
                               Foreground="White" FontSize="43" FontWeight="Bold"
                               TextWrapping="Wrap" LineHeight="51" Margin="0,16,0,0" />
                    <TextBlock Text="Compare parques de ciência com critérios claros e transforme informação em decisões fundamentadas."
                               Foreground="#B8C9BE" FontSize="15" TextWrapping="Wrap"
                               LineHeight="24" Margin="0,17,0,0" MaxWidth="440" />
                </StackPanel>

                <UniformGrid Grid.Row="2" Columns="3">
                    <Border Background="#244B3C" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="01" Foreground="#D4E68F" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Pesquisar" Foreground="White" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#244B3C" CornerRadius="12" Padding="12" Margin="0,0,8,0">
                        <StackPanel>
                            <TextBlock Text="02" Foreground="#D4E68F" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Comparar" Foreground="White" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Background="#244B3C" CornerRadius="12" Padding="12">
                        <StackPanel>
                            <TextBlock Text="03" Foreground="#D4E68F" FontSize="10" FontWeight="Bold" />
                            <TextBlock Text="Decidir" Foreground="White" FontSize="11"
                                       FontWeight="SemiBold" Margin="0,5,0,0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>
            </Grid>
        </Grid>

        <Grid Grid.Column="1" Margin="38">
            <Border MaxWidth="390" Padding="36"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1" CornerRadius="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="999"
                            Padding="10,5" HorizontalAlignment="Left" Margin="0,0,0,20">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Text="DEMONSTRAÇÃO" Foreground="{StaticResource AccentBrush}"
                                       FontSize="9" FontWeight="Bold" Margin="6,0,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Inicie sessão" FontSize="29" FontWeight="Bold"
                               TextWrapping="Wrap" />
                    <TextBlock Text="O acesso usa credenciais fixas. A autenticação segura ainda não está implementada."
                               Foreground="{StaticResource MutedBrush}" FontSize="13"
                               TextWrapping="Wrap" Margin="0,8,0,28" />

                    <TextBlock Text="Email" FontSize="12" FontWeight="SemiBold"
                               Margin="0,0,0,7" />
                    <TextBox x:Name="EmailTextBox"
                             Height="46"
                             Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                             AutomationProperties.Name="Email" />

                    <TextBlock Text="Palavra-passe" FontSize="12" FontWeight="SemiBold"
                               Margin="0,19,0,7" />
                    <PasswordBox x:Name="PasswordInput"
                                 Height="46"
                                 PasswordChanged="PasswordInput_PasswordChanged"
                                 AutomationProperties.Name="Palavra-passe" />

                    <TextBlock x:Name="ErrorMessage" Text="{Binding ErrorMessage}"
                               Foreground="#B94F3D" FontSize="12" TextWrapping="Wrap"
                               Margin="0,11,0,0" />

                    <Button Content="Entrar no ParkWise"
                            Command="{Binding LoginCommand}"
                            Style="{StaticResource ActionButtonStyle}"
                            HorizontalAlignment="Stretch"
                            Height="47" Margin="0,22,0,0" />
                    <TextBlock Text="Não utilize uma palavra-passe pessoal nesta demonstração."
                               Foreground="{StaticResource MutedBrush}" FontSize="10"
                               TextAlignment="Center" Margin="0,19,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
