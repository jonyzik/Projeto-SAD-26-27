<UserControl x:Class="ParkWise.App.Views.ScienceParkDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Background="#173C48" CornerRadius="10" Padding="16" Margin="0,0,0,18">
                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap" />
            </Border>

            <Button Content="← Voltar à pesquisa" Command="{Binding BackCommand}"
                    Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,0,0,18" />

            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Text="{Binding Name}" FontSize="23" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding City}" Foreground="{StaticResource AccentBrush}" FontSize="15" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding PriceText}" FontSize="17" FontWeight="SemiBold" Margin="0,18,0,0" />

                    <DockPanel Margin="0,22,0,0">
                        <Button DockPanel.Dock="Right" Content="Ver comparação" Command="{Binding OpenComparisonCommand}"
                                Style="{StaticResource ActionButtonStyle}" Margin="16,0,0,0" />
                        <CheckBox Content="Selecionar para comparação" IsChecked="{Binding IsSelected}"
                                  Style="{StaticResource ServiceCheckBoxStyle}" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardStyle}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Os nove critérios obrigatórios" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBlock Text="O preço é apresentado como valor mensal; a sua competitividade será avaliada na futura simulação."
                               Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,0,0,18" />
                    <ItemsControl ItemsSource="{Binding Criteria}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Name}" TextWrapping="Wrap" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource AccentBrush}"
                                               TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
