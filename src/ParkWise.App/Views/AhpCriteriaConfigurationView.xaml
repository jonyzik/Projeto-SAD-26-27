<UserControl x:Class="ParkWise.App.Views.AhpCriteriaConfigurationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel>
            <Border Style="{StaticResource StatusBannerStyle}">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                               Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding StepText}" FontWeight="SemiBold" />
                </DockPanel>
            </Border>

            <ProgressBar Minimum="0" Maximum="{Binding TotalCount, Mode=OneWay}"
                         Value="{Binding AnsweredCount, Mode=OneWay}"
                         Foreground="{StaticResource AccentBrush}"
                         Background="{StaticResource BorderBrush}"
                         Height="6" Margin="0,0,0,14" />
            <TextBlock Text="{Binding RankingMessage}" Foreground="{StaticResource MutedBrush}"
                       Margin="0,0,0,12" TextWrapping="Wrap"
                       Visibility="{Binding IsLoadingParks, Converter={StaticResource BooleanToVisibility}}" />

            <StackPanel Visibility="{Binding IsQuestionStep, Converter={StaticResource BooleanToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasSelectedParks, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Alternativas para avaliar"
                                   FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding SelectedParksText}"
                                   Foreground="{StaticResource MutedBrush}" Margin="0,5,0,12" />
                        <TextBlock Text="{Binding RankingMessage}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,10" />
                        <TextBlock Text="Cidade de preferência"
                                   FontWeight="SemiBold" Margin="0,0,0,6"
                                   Visibility="{Binding HasMultipleSelectedParks, Converter={StaticResource BooleanToVisibility}}" />
                        <ComboBox ItemsSource="{Binding PreferredCityOptions}"
                                  SelectedItem="{Binding PreferredCity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  IsEnabled="{Binding HasMultipleSelectedParks}"
                                  Height="42" VerticalContentAlignment="Center"
                                  Style="{StaticResource AhpAnswerComboBoxStyle}"
                                  AutomationProperties.Name="Cidade preferida para avaliar a localização"
                                  Visibility="{Binding HasMultipleSelectedParks, Converter={StaticResource BooleanToVisibility}}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Qual opção descreve melhor a sua preferência?"
                                   FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />

                        <Grid Margin="0,14,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CRITÉRIO A" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding LeftCriterionName}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Background="{StaticResource BackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="CRITÉRIO B" Foreground="{StaticResource MutedBrush}" FontSize="10" />
                                    <TextBlock Text="{Binding RightCriterionName}" FontSize="16"
                                               FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <TextBlock Text="Resposta" Foreground="{StaticResource MutedBrush}"
                                   FontWeight="SemiBold" Margin="0,0,0,6" />
                        <ComboBox ItemsSource="{Binding AnswerOptions}"
                                  SelectedItem="{Binding SelectedAnswer, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Height="42"
                                  VerticalContentAlignment="Center"
                                  Style="{StaticResource AhpAnswerComboBoxStyle}"
                                  AutomationProperties.Name="Preferência entre os dois critérios" />
                        <TextBlock Text="{Binding AnswerStatusText}" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="1 significa igual importância; 2–9 indicam a intensidade."
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <Button Content="Todas iguais"
                                    Command="{Binding SetAllEqualCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}" />
                            <Button Content="Recomeçar"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Margin="8,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="Atalho: use «Todas iguais» para uma primeira análise neutra."
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                    </DockPanel>
                </Border>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="Anterior" Command="{Binding PreviousCommand}"
                            IsEnabled="{Binding CanGoPrevious}" Style="{StaticResource SecondaryButtonStyle}" />
                    <Button Grid.Column="1" Content="Seguinte" Command="{Binding NextCommand}"
                            IsEnabled="{Binding CanGoNext}" Style="{StaticResource SecondaryButtonStyle}" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Primeira por responder" Command="{Binding FirstIncompleteCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Right" Margin="8,0" />
                    <Button Grid.Column="3" Content="Limpar" Command="{Binding ClearAnswerCommand}"
                            Style="{StaticResource SecondaryButtonStyle}" />
                </Grid>
                <Button Content="Ver resultados" Command="{Binding AdvanceCommand}"
                        IsEnabled="{Binding CanAdvance}" Style="{StaticResource ActionButtonStyle}"
                        HorizontalAlignment="Right" Margin="0,0,0,16" />
            </StackPanel>

            <StackPanel Visibility="{Binding IsReviewStep, Converter={StaticResource BooleanToVisibility}}">
                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{Binding ReviewHeaderText}" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ResultStateText}" Foreground="{StaticResource AccentBrush}"
                                   FontWeight="SemiBold" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding Result.ErrorMessage}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Pesos dos critérios" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,10" />
                        <TextBlock Text="Sem pesos calculados." Foreground="{StaticResource MutedBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWeights}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <ItemsControl ItemsSource="{Binding Result.Weights}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding ValueText}"
                                                   Foreground="{StaticResource AccentBrush}" Margin="12,0,0,0" />
                                        <TextBlock Text="{Binding CriterionName}" TextWrapping="Wrap" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Ranking dos parques" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding RankingMessage}" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,5,0,12" />
                        <TextBlock Text="Pontuação ponderada = soma dos pesos AHP × pontuações. Serviços: disponível = 100%, indisponível = 0%; localização: cidade escolhida = 100%; preço mensal por m²: normalizado relativamente aos parques completos selecionados, sendo o mais baixo 100%. É uma soma ponderada, não uma comparação AHP par a par entre parques."
                                   Foreground="{StaticResource MutedBrush}" FontSize="11"
                                   TextWrapping="Wrap" Margin="0,0,0,12" />
                        <ItemsControl ItemsSource="{Binding ParkRanking}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource BackgroundBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            Padding="12" Margin="0,0,0,8">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Rank}" FontSize="18" FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding City}" Foreground="{StaticResource MutedBrush}"
                                                               FontSize="11" Margin="0,2,0,0" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding ScoreText}" FontSize="16"
                                                           FontWeight="Bold" Foreground="{StaticResource AccentBrush}"
                                                           VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                            <Expander Header="Ver contribuição dos critérios" Margin="0,10,0,0">
                                                <ItemsControl ItemsSource="{Binding Criteria}" Margin="0,6,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <StackPanel Margin="0,0,0,8">
                                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding DetailText}"
                                                                           Foreground="{StaticResource MutedBrush}"
                                                                           FontSize="11" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14"
                        Visibility="{Binding HasUnrankedParks, Converter={StaticResource BooleanToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Parques sem classificação" FontSize="16" FontWeight="SemiBold" />
                        <ItemsControl ItemsSource="{Binding UnrankedParks}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Reason}" Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap" FontSize="11" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <Expander Header="Ver respostas da comparação" Margin="0,0,0,10">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <DataGrid ItemsSource="{Binding ReviewRows}" AutoGenerateColumns="False" IsReadOnly="True"
                                  CanUserAddRows="False" RowHeaderWidth="0" HeadersVisibility="Column" Height="240">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Critério A" Binding="{Binding LeftName}" Width="*" />
                                <DataGridTextColumn Header="Critério B" Binding="{Binding RightName}" Width="*" />
                                <DataGridTextColumn Header="Resposta" Binding="{Binding Choice}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Expander>

                <Expander Header="Detalhes do cálculo">
                    <Border Style="{StaticResource CardStyle}" Margin="0,8,0,0">
                        <StackPanel>
                            <TextBlock Text="Consistência" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Result.ConsistencyMessage}" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,12" />
                            <TextBlock Text="Mensagem" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Result.ErrorMessage}" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>
                </Expander>

                <Button Content="Voltar às comparações" Command="{Binding EditCommand}"
                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Left" Margin="0,14,0,12" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
